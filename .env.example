# Copy these names into your IntelliJ run configuration (or Render's environment settings).
# These are FAKE example values. Never put real secrets in this file.

# Neon database (the JDBC URL has NO username or password inside it)
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require
DATABASE_USERNAME=your-database-username
DATABASE_PASSWORD=your-database-password

# Secret key that signs login tokens (at least 32 random characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-value-of-at-least-32-characters

# Address of the React app that may call the API (comma-separated for several)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: how long a login stays valid, in minutes (default 480 = 8 hours)
# JWT_EXPIRATION_MINUTES=480